{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PredictionRecord",
  "type": "object",
  "properties": {
    "prediction_id": { "type": "string" },
    "equipment_id": { "type": "string" },
    "source_data_timestamp": { "type": "string", "format": "date-time" },
    "prediction_timestamp": { "type": "string", "format": "date-time" },
    "prediction_horizon": { "enum": ["5m", "15m", "30m", "1h", "6h", "24h"] },
    "model_version": { "type": "string" },
    "state_detection": { "enum": ["NORMAL", "DEGRADED", "ABNORMAL", "MAINTENANCE", "UNKNOWN", "INSUFFICIENT_DATA"] },
    "confidence_level": { "enum": ["HIGH_CONFIDENCE", "MODERATE_CONFIDENCE", "LOW_CONFIDENCE", "UNRELIABLE_INPUT", "OUT_OF_DISTRIBUTION", "INSUFFICIENT_DATA"] },
    "rul_hours": { "type": ["number", "null"] },
    "failure_probability": { "type": ["number", "null"], "minimum": 0.0, "maximum": 1.0 }
  },
  "required": ["prediction_id", "equipment_id", "source_data_timestamp", "prediction_timestamp", "prediction_horizon", "model_version", "state_detection", "confidence_level"]
}

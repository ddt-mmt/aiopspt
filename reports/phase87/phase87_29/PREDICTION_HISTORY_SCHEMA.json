{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PredictionHistoryRecord",
  "type": "object",
  "properties": {
    "prediction_id": { "type": "string" },
    "asset_id": { "type": "string" },
    "prediction_timestamp": { "type": "string", "format": "date-time" },
    "latest_input_timestamp": { "type": "string", "format": "date-time" },
    "model_version": { "type": "string" },
    "horizon": { "enum": ["5m", "15m", "30m", "1h", "6h", "24h", "3d", "7d", "30d"] },
    "predicted_value": { "type": "number" },
    "uncertainty_status": { "type": "string" },
    "explanation": { "type": "string" }
  },
  "required": ["prediction_id", "asset_id", "prediction_timestamp", "model_version", "horizon", "predicted_value"]
}

import os
import time
import numpy as np
import pandas as pd
from zabbix_utils import ZabbixAPI, ItemValue, Sender
from sklearn.ensemble import IsolationForest
from datetime import datetime, timezone, timedelta

# ==========================================
# 1. KONFIGURASI ZABBIX API & ENVIRONMENT
# ==========================================
ZABBIX_URL = os.getenv("ZABBIX_URL", "http://10.28.1.110/zabbix")
ZABBIX_USER = os.getenv("ZABBIX_USER", "admin")
ZABBIX_PASS = os.getenv("ZABBIX_PASS", "1sampai6")
ZABBIX_SERVER_IP = os.getenv("ZABBIX_SERVER_IP", "10.28.1.110")
INTERVAL_SECONDS = int(os.getenv("INTERVAL_SECONDS", "60"))
DAYS_WINDOW = int(os.getenv("DAYS_WINDOW", "30"))

# ==========================================
# 2. DATA QUALITY GATING & MAPPING (V6)
# ==========================================
def get_ups_sensor_dict(item_map):
    raw_keys = [
        'output.load[upsHighPrecOutputLoad]',
        'battery.voltage[upsHighPrecBatteryActualVoltage]',
        'battery.capacity[upsHighPrecBatteryCapacity]',
        'battery.runtime_remaining[upsAdvBatteryRunTimeRemaining]'
    ]
    sensor_dict = {}
    for k in raw_keys:
        if k in item_map:
            clean_name = k.split('[')[0] if '[' in k else k
            sensor_dict[clean_name] = item_map[k]
    return sensor_dict

def get_pac_sensor_dict(item_map, hostname):
    sensor_dict = {}
    base_keys = ['return.temp.c', 'supply.temp.c', 'return.humidity.rh', 'evaporator.fan.speed']
    for k in base_keys:
        if k in item_map:
            sensor_dict[k] = item_map[k]
    if 'compressor.1.status' in item_map:
        sensor_dict['compressor.status'] = item_map['compressor.1.status']
    elif 'compressor.status' in item_map:
        sensor_dict['compressor.status'] = item_map['compressor.status']
    return sensor_dict

def get_sensor_history_v6(zapi, item_ids_dict, days=30):
    """
    Ekstraksi history dengan Optimasi v6:
    - Adaptive ffill limits: 6 jam untuk battery.capacity, 5 menit untuk lainnya.
    - Menghitung Confidence Score (0-1).
    """
    if not item_ids_dict:
        return None, "INSUFFICIENT_DATA", "Daftar sensor kosong", 0.0

    now_epoch = int(time.time())
    time_from = now_epoch - int(days * 86400)
    now_utc = pd.Timestamp.now(tz="UTC")
    max_age_seconds = max(600, 10 * INTERVAL_SECONDS)

    series_by_name = {}
    latest_by_name = {}
    sample_counts = {}

    for name, item_id in item_ids_dict.items():
        item_info = zapi.item.get(itemids=[item_id], output=["value_type"])
        if not item_info: continue
        
        v_type = int(item_info[0]["value_type"])
        history = zapi.history.get(
            itemids=[item_id], time_from=time_from, time_till=now_epoch,
            history=v_type, output="extend"
        )
        if not history: continue

        df = pd.DataFrame(history)
        df["value"] = pd.to_numeric(df["value"], errors="coerce")
        df["clock"] = pd.to_datetime(df["clock"].astype(int), unit="s", utc=True)
        df = df.dropna(subset=["clock", "value"]).sort_values("clock").drop_duplicates(subset=["clock"], keep="last")
        
        if df.empty: continue

        sample_counts[name] = len(df)
        latest_by_name[name] = df["clock"].max()

        s = df.set_index("clock")["value"].resample("1min").last().rename(name)
        
        # Adaptive Fill Limit:
        # battery.capacity is very static, allow 6 hours fill (360 samples)
        # others allow 5 minutes fill (5 samples)
        fill_limit = 360 if 'capacity' in name else 5
        series_by_name[name] = s.ffill(limit=fill_limit)

    if not series_by_name:
        return None, "INSUFFICIENT_DATA", "Tidak ada data sensor numerik", 0.0

    # Calculate Freshness (40% weight)
    avg_age = np.mean([int((now_utc - stamp).total_seconds()) for stamp in latest_by_name.values()])
    freshness_score = max(0.0, 1.0 - (avg_age / (max_age_seconds * 2)))
    
    # Calculate Density (60% weight)
    total_obs = sum(sample_counts.values())
    expected_obs = len(item_ids_dict) * (days * 1440)
    density_score = min(1.0, (total_obs / expected_obs) * 5) # Multiplier for APC conservative polling

    confidence_score = (0.4 * freshness_score) + (0.6 * density_score)
    
    merged = pd.concat(series_by_name.values(), axis=1).sort_index().dropna()

    if len(merged) < 10:
        return None, "INSUFFICIENT_DATA", f"Sampel selaras {len(merged)} < 10", confidence_score

    merged = merged.reset_index().rename(columns={merged.index.name if merged.index.name else 'index': 'clock'})
    if 'timestamp' in merged.columns: merged = merged.rename(columns={'timestamp': 'clock'})
    
    return merged, "NORMAL", "OK", confidence_score

# ==========================================
# 3. MESIN PREDIKTIF (V6)
# ==========================================
def calculate_multisensor_rul_v6(df, crit_val):
    feature_cols = [c for c in df.columns if c != "clock"]
    X = df[feature_cols].to_numpy(dtype=float)
    
    model = IsolationForest(contamination=0.05, random_state=42)
    model.fit(X)
    
    latest_val = X[-1].reshape(1, -1)
    prediction = int(model.predict(latest_val)[0])
    anomaly_score = float(model.decision_function(latest_val)[0])
    health_score = round(max(0.0, min(100.0, (anomaly_score + 0.5) * 100)), 2)

    continuous_candidates = [c for c in feature_cols if 'status' not in c.lower()]
    primary_col = continuous_candidates[0] if continuous_candidates else feature_cols[0]
    
    primary = df[primary_col].rolling(window=60, min_periods=1).mean()
    times = (df["clock"] - df["clock"].iloc[0]).dt.total_seconds().to_numpy() / 3600.0
    
    slope = float(np.polyfit(times, primary.to_numpy(), 1)[0])
    curr = float(primary.iloc[-1])
    
    ttf = round(max(1.0, min(8760.0, (crit_val - curr) / slope)), 1) if slope > 1e-5 and curr < crit_val else None
    
    return prediction, health_score, ttf

def determine_action_status_v6(health, ttf, q_status):
    if q_status != "NORMAL": return 3 # DATA_ERROR
    if health < 40 or (ttf is not None and ttf <= 24): return 2 # REPLACE
    if health < 70 or (ttf is not None and ttf <= 720): return 1 # MAINTENANCE
    return 0 # NORMAL

def run_aiops_cycle_v6():
    try:
        zapi = ZabbixAPI(url=ZABBIX_URL, user=ZABBIX_USER, password=ZABBIX_PASS)
        all_hosts = zapi.host.get(output=['hostid', 'host'])
        
        for h in all_hosts:
            hname, hostid = h['host'], h['hostid']
            if not (hname.startswith('ME_UPS') or hname.startswith('ME_PAC')): continue
            
            items = zapi.item.get(hostids=hostid, output=['itemid', 'key_'])
            item_map = {it['key_']: it['itemid'] for it in items}
            s_dict = get_ups_sensor_dict(item_map) if hname.startswith('ME_UPS') else get_pac_sensor_dict(item_map, hname)
            
            try:
                df, q_status, q_msg, conf_score = get_sensor_history_v6(zapi, s_dict, days=DAYS_WINDOW)
                if q_status == "NORMAL":
                    pred, health, ttf = calculate_multisensor_rul_v6(df, 95.0 if hname.startswith('ME_UPS') else 35.0)
                else:
                    health, ttf = 0.0, None
                
                action = determine_action_status_v6(health, ttf, q_status)
                conf_label = "HIGH" if conf_score > 0.8 else ("MEDIUM" if conf_score > 0.5 else "LOW")
                
                print(f"[{hname}] Health: {health}% | TTF: {ttf} | Action: {action} | Conf: {conf_label} ({conf_score:.2f})")
            except Exception as e:
                print(f"Error {hname}: {e}")

    except Exception as e:
        print(f"Cycle Error: {e}")

if __name__ == "__main__":
    print("Kandidat v6 (Optimasi UPS & Confidence) siap.")
